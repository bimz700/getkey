{
  "rewrites": [
    { "source": "/get-key", "destination": "/get-key.html" },
    { "source": "/s/:token", "destination": "/api/shortlink?token=:token" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ]
}
