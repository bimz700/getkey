{
  "rules": {
    "keys": {
      ".read": true,
      ".write": false,

      "$key": {
        "claims": {
          "$device": {
            ".write": "!data.exists() && newData.hasChildren(['claimedAt', 'expiredAt'])",
            ".validate": "newData.hasChildren(['claimedAt', 'expiredAt'])"
          }
        }
      },

      ".indexOn": ["status", "createdAt"]
    }
  }
}
